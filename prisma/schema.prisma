generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CEO
  CTO
  CFO
  sales_manager
  sales_executive
  vendor_manager
  investor_manager
  customer_support
  DEPARTMENT_HEAD
  LEAD_MANAGER
  USER
}

enum Platform {
  WEBSITE
  WHATSAPP
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  role Role @default(USER)

  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatSessions ChatSession[]

  assignedLeads Lead[]

  @@index([departmentId])
}

model ChatSession {
  id String @id @default(cuid())

  platform Platform

  departmentId String

  department Department @relation(fields: [departmentId], references: [id])

  status SessionStatus @default(ACTIVE)

  visitorName     String?
  visitorEmail    String?
  visitorPhone    String?
  visitorLocation String?
  ip              String?

  isEscalated Boolean @default(false)

  escalatedAt DateTime?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  messages ChatMessage[]

  @@index([departmentId])
  @@index([platform])
}

model ChatMessage {
  id String @id @default(cuid())

  sessionId String

  sender SenderType

  message String @db.LongText

  responseTimeMs Int?

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Lead {
  id String @id @default(cuid())

  name     String
  email    String?
  phone    String?
  location String?
  source   Platform

  departmentId String

  department Department @relation(fields: [departmentId], references: [id])

  status LeadStatus @default(NEW)

  notes String? @db.LongText

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

enum SenderType {
  USER
  AI
  AGENT
  SYSTEM
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationType {
  COMPANY
  CUSTOMER
  INVESTOR
  VENDOR
  DEALER
  PARTNER
  FPO
  GOVERNMENT
  FRANCHISE
}

model Organization {
  id String @id @default(cuid())

  name String
  code String? @unique

  type OrganizationType

  industry String?

  website String?

  email String?
  phone String?

  addressLine1 String?
  addressLine2 String?

  city       String?
  state      String?
  country    String?
  postalCode String?

  gstNumber String?
  panNumber String?

  status Status @default(ACTIVE)

  parentId String?

  parent Organization? @relation("OrganizationHierarchy", fields: [parentId], references: [id])

  children Organization[] @relation("OrganizationHierarchy")

  departments Department[]

  contacts Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([parentId])
}

model Department {
  id String @id @default(cuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  code String? @unique

  description String?

  headUserId String?

  status Status @default(ACTIVE)

  users User[]

  leads Lead[]

  chatSessions ChatSession[]

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Service {
  id String @id @default(cuid())

  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name String

  code String? @unique

  category String?

  description String? @db.Text

  status Status @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

model Contact {
  id String @id @default(cuid())

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  firstName String
  lastName  String?

  email String?
  phone String?

  designation String?

  department String?

  linkedInUrl String?

  status Status @default(ACTIVE)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([phone])
}
